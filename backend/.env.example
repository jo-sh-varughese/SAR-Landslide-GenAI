# Copy to `.env` and adjust as needed. All values have safe defaults in app/core/config.py.

ENVIRONMENT=development
REQUIRE_API_KEY=false
API_KEY=dev-local-key

CORS_ORIGINS=["http://localhost:3000"]

REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true

# NASA Earthdata credentials for asf_search (https://urs.earthdata.nasa.gov/)
ASF_USERNAME=
ASF_PASSWORD=
